      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(pkill -9 *)", "Bash(killall *)"
    ],
    "additionalDirectories": ["/home/svend/flows", "/home/svend/FlowRunner"]
  }
}
