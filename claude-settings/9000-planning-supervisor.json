{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
  "Bash(*)", "Read", "Edit", "Write", "Glob", "Grep",
  "mcp__mcp-light__*",
  "Monitor", "TaskStop", "TaskOutput", "SendMessage", "ListAgents"
