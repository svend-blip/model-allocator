#!/usr/bin/env bash
set -euo pipefail

# PATH wrapper for model-allocator.
# Prefer a project-local venv interpreter; allow override via MODEL_ALLOCATOR_PYTHON.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_DIR=$(dirname "$SCRIPT_DIR")

PYTHON="${MODEL_ALLOCATOR_PYTHON:-}"

if [ -z "$PYTHON" ] && [ -x "$PROJECT_DIR/.venv/bin/python3" ]; then
    PYTHON="$PROJECT_DIR/.venv/bin/python3"
fi

if [ -z "$PYTHON" ] && [ -x "$PROJECT_DIR/venv/bin/python3" ]; then
    PYTHON="$PROJECT_DIR/venv/bin/python3"
fi

if [ -z "$PYTHON" ]; then
    PYTHON="python3"
fi

exec "$PYTHON" -m model_allocator "$@"
